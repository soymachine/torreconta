# Copia este fichero a .env.local y rellénalo con la configuración de tu app
# web (Consola de Firebase → Configuración del proyecto → Tus apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true para trabajar contra los emuladores locales (npm run emulators)
VITE_USE_EMULATORS=false
